{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "destination": {
                "service": "backend"
            },
            "source": "/api/(.*)"
        },
        {
            "destination": {
                "service": "frontend"
            },
            "source": "/(.*)"
        }
    ],
    "services": {
        "backend": {
            "functions": {
                "config/wsgi.py": {
                    "maxDuration": 60
                }
            },
            "root": "backend/"
        },
        "frontend": {
            "buildCommand": "npm run build",
            "outputDirectory": "dist",
            "rewrites": [
                {
                    "destination": "/index.html",
                    "source": "/(.*)"
                }
            ],
            "root": "frontend/"
        }
    }
}
